routine B32 dividir_cuatro[B32 valor] {
    output valor / 4.
}

routine B32 residuo_cuatro[B32 valor] {
    output valor % 4.
}

routine B32 combinar[B32 a, B32 b, B32 c] {
    output a / b + c % b.
}

routine B32 sumar_cuatro[B32 a, B32 b, B32 c, B32 d] {
    output a + b + c + d.
}

routine B32 main[] {
    create B32|2| valores.
    create B32 divisor.
    create B32 cociente.
    create B32 residuo.
    create B32 combinado.
    create B32 potencia.
    create uB32 grande.
    divisor store 3.
    cociente store dividir_cuatro[-13].
    residuo store residuo_cuatro[-13].
    combinado store combinar[-17, 3, 20].
    valores|1| store combinado / divisor.
    potencia store divisor ^ 3.
    grande store 4294967295.
    output sumar_cuatro[cociente, residuo, valores|1|, potencia].
}
