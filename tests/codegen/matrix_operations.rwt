routine B32 sumar[B32|2&2| a, B32|2&2| b, B32|2&2| c] {
    create B32 i.
    create B32 j.
    loop[i & 0 -> 2 & 1] {
        loop[j & 0 -> 2 & 1] {
            c|i&j| store a|i&j| + b|i&j|.
        }
    }
    output c|1&1|.
}

routine B32 multiplicar[B32|2&3| a, B32|3&2| b, B32|2&2| c] {
    create B32 i.
    create B32 j.
    create B32 k.
    create B32 acumulado.
    loop[i & 0 -> 2 & 1] {
        loop[j & 0 -> 2 & 1] {
            acumulado store 0.
            loop[k & 0 -> 3 & 1] {
                acumulado store acumulado + a|i&k| * b|k&j|.
            }
            c|i&j| store acumulado.
        }
    }
    output c|1&1|.
}

routine B32 main[] {
    create B32|2&3| a.
    create B32|3&2| b.
    create B32|2&2| producto.
    create B32|2&2| suma.
    create B32 estado.
    a store [[1, 2, 3], [4, 5, 6]].
    b store [[7, 8], [9, 10], [11, 12]].
    producto store [[0, 0], [0, 0]].
    estado store multiplicar[a, b, producto].
    estado store sumar[producto, producto, suma].
    output suma|0&0| + suma|0&1| + suma|1&0| + suma|1&1|.
}
