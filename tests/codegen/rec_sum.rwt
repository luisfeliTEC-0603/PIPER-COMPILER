~~ Suma recursiva con una llamada dentro de output y una expresion envolvente.
~~ Aisla el bug de stack_off en codegen_call: la llamada aparece como
~~ operando de una suma, no como sentencia suelta.

routine B32 rec[
    B32 n, B32 acc, B32 extra1, B32 extra2, B32 extra3, B32 extra4
] {
    when [n = 0] {
        output acc.
    }
    output rec[n - 1, acc + n, extra1, extra2, extra3, extra4].
}

routine B32 main[] {
    create B32 r.
    r store rec[3, 0, 10, 20, 30, 40].
    output r.
}
