~~ Primer global: bloque de 8 bytes en 0x10000, compatible con el loader.
create B32|2| block.

routine B32 main[] {
    ~~ Sin datos externos, usar L=0x01234567 y R=0x89ABCDEF.
    when [block|0| = 0 and block|1| = 0] {
        block store [19088743, -1985229329].
    }

    ~~ Contraseña inicial del RTL, desde la palabra menos significativa.
    crypto_auth[3757111146, 2846257176, 3662207751, 342038459].
    crypto_write_key[2712847316, 0, 0].
    ~~ Las otras tres subllaves valen cero después de reset.
    ~~ Cada ronda reinicia el timeout de 32 ciclos; basta autenticar una vez.
    crypto_feistel[block, 0, 0].
    crypto_feistel[block, 1, 0].
    crypto_feistel[block, 2, 0].
    crypto_feistel[block, 3, 0].
    crypto_revoke[].

    output block|0|.
}
