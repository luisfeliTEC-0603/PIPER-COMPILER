routine B32 potencia[B32 base, B32 exponente] {
    output base ^ exponente.
}

routine uB32 potencia_sin_signo[uB32 base, uB32 exponente] {
    output base ^ exponente.
}

routine B32 main[] {
    create B32 impar.
    create B32 par.
    create B32 cero.
    create B32 extremo.
    create uB32 grande.
    impar store potencia[-3, 3].
    par store potencia[-3, 4].
    cero store potencia[0, 0].
    extremo store potencia[-2, 31].
    grande store potencia_sin_signo[2, 31].
    output impar + par + cero.
}
