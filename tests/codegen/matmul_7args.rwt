~~ Multiplicacion de matrices 2x2 y 2x3 con 7 parametros.
~~ Ejercita la ABI extendida de argumentos en pila (params 5..7).

routine B32 mat_step[
    B32|2&2| A, B32|2&3| B, B32|2&3| C,
    B32 i, B32 j, B32 k, B32 acc
] {
    when [i = 2] {
        output 0.
    }
    when [j = 3] {
        output 0.
    }
    when [k = 3] {
        C|i&j| store acc.
        output mat_step[A, B, C, i, j + 1, 0, 0].
    }
    output mat_step[A, B, C, i, j, k + 1, acc + A|i&k| * B|k&j|].
}

routine B32 mat_mul[
    B32|2&2| A, B32|2&3| B, B32|2&3| C
] {
    output mat_step[A, B, C, 0, 0, 0, 0].
}

routine B32 main[] {
    create B32|2&2| A.
    A store [[1, 2], [3, 4]].
    create B32|2&3| B.
    B store [[5, 6, 7], [8, 9, 10]].
    create B32|2&3| C.
    C store [[0, 0, 0], [0, 0, 0]].
    create B32 estado.
    estado store mat_mul[A, B, C].
    output estado.
}
