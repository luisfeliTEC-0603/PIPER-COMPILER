routine B32 dividir[B32 dividendo, B32 divisor] {
    output dividendo / divisor.
}

routine uB32 dividir_sin_signo[uB32 dividendo, uB32 divisor] {
    output dividendo / divisor.
}

routine B32 main[] {
    create B32 negativo.
    create B32 positivo.
    create uB32 grande.
    negativo store dividir[-17, 3].
    positivo store dividir[-17, -3].
    grande store dividir_sin_signo[4294967295, 3].
    output negativo + positivo.
}
