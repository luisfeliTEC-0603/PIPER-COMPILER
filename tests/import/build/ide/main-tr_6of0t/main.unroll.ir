function cuadrado(x:B32) -> B32
    variables: local resultado:B32
    temporales: t0:B32, t1:B32, t2:B32, t3:B32
    constantes:
B0:
    t0 = x
    t1 = x
    t2 = t0 * t1 ; comprueba rango del resultado B32, puede fallar
    resultado = t2
    t3 = resultado
    return t3

function main() -> B32
    variables: local i:B32, local suma:B32, local val:B32
    temporales: t0:B32, t1:bool, t2:B32, t3:B32, t4:B32, t5:B32, t6:B32, t7:B32, t8:B32, t9:B32, t10:bool, t11:B32
    constantes: 0:B32, 1:B32, 4:B32, 10:B32
B0:
    suma = 0
    i = 1
    jump B1
B1:
    t0 = i
    t1 = t0 < 4
    if t1 jump B2 else B3
B2:
    t2 = i
    t3 = call cuadrado(t2) ; lee memoria, escribe memoria, lee estado criptográfico, escribe estado criptográfico, puede fallar
    val = t3
    t4 = suma
    t5 = val
    t6 = t4 + t5 ; comprueba rango del resultado B32, puede fallar
    suma = t6
    jump B4
B3:
    t9 = suma
    t10 = t9 > 10
    if t10 jump B5 else B6
B4:
    t7 = i
    t8 = t7 + 1
    i = t8
    jump B1
B5:
    t11 = suma
    return t11
B6:
    return 0
