graph InterferenciaIR {
  graph [label="Interferencia IR preliminar", labelloc=t, fontname="sans-serif"];
  node [shape=circle, fontname="monospace"];
  subgraph cluster_r0 {
    label="rutina 0: cuadrado";
    r0_t0 [label="t0\n(grado 1)"];
    r0_t1 [label="t1\n(grado 1)"];
    r0_t2 [label="t2\n(grado 0)"];
    r0_t3 [label="t3\n(grado 0)"];
    r0_t0 -- r0_t1;
  }
  subgraph cluster_r1 {
    label="rutina 1: main";
    r1_t0 [label="t0\n(grado 0)"];
    r1_t1 [label="t1\n(grado 0)"];
    r1_t2 [label="t2\n(grado 0)"];
    r1_t3 [label="t3\n(grado 0)"];
    r1_t4 [label="t4\n(grado 1)"];
    r1_t5 [label="t5\n(grado 1)"];
    r1_t6 [label="t6\n(grado 0)"];
    r1_t7 [label="t7\n(grado 0)"];
    r1_t8 [label="t8\n(grado 0)"];
    r1_t9 [label="t9\n(grado 0)"];
    r1_t10 [label="t10\n(grado 0)"];
    r1_t11 [label="t11\n(grado 0)"];
    r1_t4 -- r1_t5;
  }
}
