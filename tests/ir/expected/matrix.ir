function main() -> B16
    variables: local m:B16[2x3], local fila:B32
    temporales: t0:&B16, t1:&B16, t2:&B16, t3:&B16, t4:&B16, t5:&B16, t6:B32, t7:B32, t8:B32, t9:&B16, t10:B32, t11:&B16, t12:B32, t13:B32, t14:&B16, t15:B32, t16:&B16, t17:B16, t18:B32, t19:B32, t20:B32, t21:&B16, t22:B32, t23:&B16, t24:B16, t25:B16
    constantes: 1:B16, 2:B32, 2:B16, 4:B32, 3:B16, 6:B32, 4:B16, 8:B32, 5:B16, 10:B32, 6:B16, 1:B32, 0:B32, 3:B32, 7:B16
B0:
    t0 = &m
    *t0 = 1:B16 ; escribe memoria
    t1 = t0 + 2:B32
    *t1 = 2:B16 ; escribe memoria
    t2 = t0 + 4:B32
    *t2 = 3:B16 ; escribe memoria
    t3 = t0 + 6:B32
    *t3 = 4:B16 ; escribe memoria
    t4 = t0 + 8
    *t4 = 5 ; escribe memoria
    t5 = t0 + 10
    *t5 = 6:B16 ; escribe memoria
    fila = 1:B32
    t6 = fila
    check 0 <= t6 < 2:B32 ; puede fallar
    check 0 <= 0 < 3:B32 ; puede fallar
    t7 = t6 * 3:B32
    t8 = t7 + 0
    t9 = &m
    t10 = t8 * 2:B32
    t11 = t9 + t10
    *t11 = 7 ; escribe memoria
    check 0 <= 0 < 2:B32 ; puede fallar
    check 0 <= 2:B32 < 3:B32 ; puede fallar
    t12 = 0 * 3:B32
    t13 = t12 + 2:B32
    t14 = &m
    t15 = t13 * 2:B32
    t16 = t14 + t15
    t17 = *t16 ; lee memoria
    t18 = fila
    check 0 <= t18 < 2:B32 ; puede fallar
    check 0 <= 0 < 3:B32 ; puede fallar
    t19 = t18 * 3:B32
    t20 = t19 + 0
    t21 = &m
    t22 = t20 * 2:B32
    t23 = t21 + t22
    t24 = *t23 ; lee memoria
    t25 = t17 + t24 ; comprueba rango del resultado B16, puede fallar
    return t25
