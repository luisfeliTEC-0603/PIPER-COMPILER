routine B32 derive_key[B32 value] {
    when [value >= 256] {
        output value - 256.
    }

    output value.
}

routine B32 transform[B32 value, B32 key] {
    output value xor key.
}

bring derive_key from "keys.rwt".
bring transform from "cipher.rwt".

routine bool main[] {
    create B32|4| message.
    message store [65, 66, 67, 68].

    create B32 seed.
    seed store 254.

    create B32 key.
    create B32 encrypted.
    create B32 restored.

    loop[position & 0 -> 4 & 1] {
        key store derive_key[seed + position].

        encrypted store transform[message|position|, key].
        restored store transform[encrypted, key].

        when [restored = message|position|] {
            output true.
        }
        fallback {
            output false.
        }
    }
}