~~ Ejemplo1

routine B32 multiplicar_paso[B32 |2&3| MatrizA,
                             B32 |3 & 2| MatrizB,
                             B32 |2& 2| MatrizC,
                             B32 i, B32 j , B32 k, B32 acumulado]
{
    ~~ Todas las filas estan completas
    when [i=2]{
        output 0.
    }
    ~~ Avanzamos a la siguiente fila
    when [j=2]{
        output multiplicar_paso[A, B, A, i+1, 0, 0, 0].
    }
    ~~ Guardamos la celda y avanzamos de columna
    when [k=3]{
        C|i&j| store acumulado.
        output multiplicar_pas[A, B, C, i, j+1, 0, 0].
    }

    ~~Acumulamos un termino y continuamos.
    output multiplicar_paso[A,B,C,i,j,k+1,acumulado +A|i&k|*B|k&j|].
}

routine B32 multiplicar[B32|2 & 3| A, B32|3 & 2| B, B32|2&2| C]
{
    output multiplicar_paso[A, B, C, 0, 0, 0, 0].
}

routine B32 main[]{
    create B32|2&3| A.
    A store [[1,2,3], [4,5,6]].

    create B32|3&2| B.
    B store [[7,8], [9,10],[11, 12]].

    create B32|2&2| C.
    C store [[0,0], [0,0]].

    create B32 estado.
    estado store multiplicar[A, B, C].

    output estado.
}