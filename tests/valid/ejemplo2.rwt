~~Ejemplo2: Merge Sort

routine B32 merge[
    B32|7| values, B32|7| buffer,
    B32 start, B32 middle, B32 end
] {
    create B32 left.
    left store start.

    create B32 right.
    right store middle.

    create B32 position.
    position store start.

    alwhen [left < middle and right < end] {
        when [values|left| <= values|right|] {
            buffer|position| store values|left|.
            left store left + 1.
        }
        fallback {
            buffer|position| store values|right|.
            right store right + 1.
        }

        position store position + 1.
    }

    alwhen [left < middle] {
        buffer|position| store values|left|.
        left store left + 1.
        position store position + 1.
    }

    alwhen [right < end] {
        buffer|position| store values|right|.
        right store right + 1.
        position store position + 1.
    }

    output 0.
}

routine B32 merge_sort[B32|7| values] {
    create B32|7| buffer.
    buffer store [0, 0, 0, 0, 0, 0, 0].

    create B32 width.
    width store 1.

    create B32 start.
    create B32 middle.
    create B32 end.
    create B32 position.
    create B32 status.

    alwhen [width < 7] {
        start store 0.

        alwhen [start < 7] {
            middle store start + width.
            end store middle + width.

            when [middle > 7] {
                middle store 7.
            }

            when [end > 7] {
                end store 7.
            }

            status store merge[values, buffer, start, middle, end].
            start store end.
        }

        position store 0.

        alwhen [position < 7] {
            values|position| store buffer|position|.
            position store position + 1.
        }

        width store width + width.
    }

    output 0.
}

routine B32 main[] {
    create B32|7| values.
    values store [38, 27, 43, 3, 9, 82, 10].

    create B32 status.
    status store merge_sort[values].

    create B32 position.
    position store 0.

    alwhen [position < 7] {
        position store position + 1.
    }

    output status.
}